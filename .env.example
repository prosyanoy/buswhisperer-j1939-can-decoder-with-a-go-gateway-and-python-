# Gateway configuration (all optional; these are the defaults).
# Copy to .env for docker compose, or export in your shell.

# Path to the C decoder binary (default: bw_decode next to the gateway, else on PATH)
BW_DECODER=build/bw_decode
# candump log to replay ("-" reads stdin)
BW_LOG=data/sample.log
# Where to send batches: file | http
BW_SINK=file
# file sink: length-delimited SignalBatch stream
BW_OUT=signals.pb
# http sink: receives one SignalBatch per POST (application/x-protobuf)
BW_HTTP_URL=http://localhost:8080/ingest
BW_HTTP_RETRIES=3
# batching: flush at N signals or after this many ms, whichever comes first
BW_BATCH_SIZE=100
BW_FLUSH_INTERVAL_MS=1000
